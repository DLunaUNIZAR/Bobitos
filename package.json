{
  "name": "bobitos-firebase-local",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "emulators": "firebase emulators:start --project demo-bobitos",
    "android:connect-emulators": "node scripts/connect-android-emulators.mjs",
    "seed:emulators": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node scripts/seed-emulators.mjs",
    "test:emulators": "firebase emulators:exec --only auth,firestore --project demo-bobitos \"node --test tests/firebase-emulators.test.mjs\"",
    "beta:distribute": "node scripts/distribute-beta.mjs",
    "catalog:fetch": "node scripts/catalog/fetch-wger.mjs",
    "catalog:candidates": "node scripts/catalog/build-catalog.mjs --candidates",
    "catalog:build": "node scripts/catalog/build-catalog.mjs",
    "test:scripts": "node --test tests/beta-release-check.test.mjs tests/catalog-normalize.test.mjs tests/catalog-selection.test.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "firebase": "12.16.0",
    "firebase-tools": "15.23.0"
  }
}
